# Paste the full connection string from Atlas → Connect → Drivers
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://officialsurjithk_db_user:YOUR_PASSWORD@REPLACE_ME.mongodb.net/office-visit-calendar?retryWrites=true&w=majority
MONGODB_DB=office-visit-calendar
PORT=3001

# Long random string used to sign login tokens (required in production)
AUTH_SECRET=change-me-to-a-long-random-string
