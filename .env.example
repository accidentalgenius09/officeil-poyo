# Paste the full connection string from Atlas → Connect → Drivers
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://officialsurjithk_db_user:YOUR_PASSWORD@REPLACE_ME.mongodb.net/office-visit-calendar?retryWrites=true&w=majority
MONGODB_DB=office-visit-calendar
PORT=3001

# Long random string used to sign login tokens (required in production)
AUTH_SECRET=change-me-to-a-long-random-string

# Groq API key (server-only; used to elaborate work status notes)
GROQ_API_KEY=YOUR_GROQ_API_KEY
# Optional model override (default openai/gpt-oss-20b)
# GROQ_MODEL=openai/gpt-oss-20b

# Monday digest email (Brevo). Cron runs 08:00 India time.
# CRON_SECRET must also be set in Vercel — Vercel sends it as Authorization: Bearer …
CRON_SECRET=change-me-to-another-long-random-string
BREVO_API_KEY=xkeysib-your_brevo_api_key
DIGEST_FROM=Officeil Poyo <you@gmail.com>
# Public app link used by the “Open live calendar” button in the digest mail
APP_URL=https://officeil-poyo.vercel.app
# DIGEST_TIMEZONE=Asia/Kolkata
